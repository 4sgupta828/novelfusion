# Anthropic API key (required for LLM pipeline stages: extract, weave, distill, ratify, regress)
ANTHROPIC_API_KEY=

# Model override (default: claude-opus-4-8). Change only deliberately.
NF_MODEL=claude-opus-4-8

# SQLite database path (default: data/novelfusion.db)
NF_DB_PATH=

# Feature flags (Rule 20) — default OFF
NF_FLAG_CONFIDENCE_ROUTING=false
