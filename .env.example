# Anthropic API key (required for LLM pipeline stages: extract, weave, distill, ratify, regress, query)
ANTHROPIC_API_KEY=

# OpenAI API key (required ONLY when corpus retrieval is enabled: passage embeddings +
# the different-family faithfulness judge). Unused when NF_FLAG_CORPUS_QUERY is off.
OPENAI_API_KEY=

# Exa (exa.ai) API key — required ONLY when source discovery is enabled (neural web search).
# Unused when NF_FLAG_SOURCE_DISCOVERY is off.
EXA_API_KEY=

# Model override (default: claude-opus-4-8). Change only deliberately.
NF_MODEL=claude-opus-4-8

# SQLite database path (default: data/novelfusion.db)
NF_DB_PATH=

# Feature flags (Rule 20) — default OFF
NF_FLAG_CONFIDENCE_ROUTING=false
# Corpus hybrid retrieval + grounded Query (embeddings + FTS + answer-with-receipts). OFF =
# ingest byte-identical, no OpenAI calls, Query route disabled. Needs OPENAI_API_KEY when on.
NF_FLAG_CORPUS_QUERY=false
# Retain original uploaded bytes so a source can be downloaded. Default ON (an explicitly
# requested feature); set false to stop retaining raw PII and hide the download affordance.
NF_FLAG_RETAIN_ORIGINALS=true
# Auto-discover public web sources via Exa (results land quarantined, pending review). OFF =
# no Exa calls, Discover route disabled. Needs EXA_API_KEY when on.
NF_FLAG_SOURCE_DISCOVERY=false
